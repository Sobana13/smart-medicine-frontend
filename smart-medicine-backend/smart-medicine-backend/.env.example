# Copy this file to ".env" and edit the copy. NEVER commit ".env" to GitHub.

# ---- App ----
APP_ENV=development              # development | production
SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING   # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///medicine.db
TIMEZONE=Asia/Kolkata            # default timezone for new patients
GRACE_PERIOD_MINUTES=30          # minutes after scheduled time before a dose can be marked missed
EARLY_REPORT_MINUTES=120         # how early a patient may report a dose as taken
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500   # your frontend address(es). Never use *

# ---- Safety switch ----
# true  = NO real WhatsApp messages are ever sent (messages are only recorded as "demo_not_sent")
# false = real messages are sent, but only if every WHATSAPP_* value below is filled in
DEMO_MODE=true

# ---- Scheduler ----
SCHEDULER_ENABLED=true           # set false for web workers if you run run_scheduler.py separately
SCHEDULER_INTERVAL_SECONDS=60

# ---- Meta WhatsApp Cloud API (get these from developers.facebook.com) ----
WHATSAPP_ACCESS_TOKEN=REPLACE_ME            # keep secret
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=REPLACE_ME_WITH_A_RANDOM_STRING   # you invent this; paste the same value in the Meta webhook form
WHATSAPP_APP_SECRET=REPLACE_ME              # App settings > Basic > App secret (used to verify webhook signatures)
# Names of message templates approved in WhatsApp Manager (see README)
WHATSAPP_TEMPLATE_REMINDER=medicine_reminder
WHATSAPP_TEMPLATE_CAREGIVER=caregiver_missed_alert
WHATSAPP_TEMPLATE_LANG=en
